# Copy to .env for local development. Render: set these in the dashboard.

# Supabase Postgres connection string:
# Dashboard -> Connect (button at top) -> "Session pooler" URI
# (use the Session pooler URI — it works on IPv4 networks like Render;
# replace [YOUR-PASSWORD] with your database password)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres

# Supabase JWT secret — used to verify the access token the client sends.
# Dashboard -> Project Settings -> API -> JWT Settings -> "JWT Secret".
# Without it, every request is treated as anonymous (answers won't link to users).
SUPABASE_JWT_SECRET=

# Optional: restrict CORS to specific origins (comma-separated), or "*".
# Defaults to the known dotcomma + *.vercel.app + localhost origins.
# CORS_ORIGINS=https://dotcomma.com.au,https://www.dotcomma.com.au

# Anthropic API key — powers the AI answer judge (ai-judge.js). Without it,
# answers are still stored and scored, but the AI verdict is skipped.
ANTHROPIC_API_KEY=

# E-mail for the answers Opus still can't settle (stragglers). Standard SMTP;
# e.g. a Gmail App Password, or any transactional-mail provider's SMTP creds.
# If SMTP_HOST is unset, stragglers are logged instead of e-mailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Where straggler alerts go (defaults to petergibson127@gmail.com).
ALERT_EMAIL_TO=petergibson127@gmail.com
# From address (defaults to SMTP_USER).
ALERT_EMAIL_FROM=
