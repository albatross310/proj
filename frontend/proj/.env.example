# Copy to .env for local dev; set these in the Vercel project for production.

# Supabase Auth (Settings -> API). The anon key is public and safe to expose.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon public key>

# Backend API base URL (the Fastify server). Optional in dev — defaults to
# http://localhost:3000.
# VITE_API_URL=https://your-backend.onrender.com
